# Google Maps Platform の API キー（サーバーサイドでのみ使用する）
GOOGLE_MAPS_API_KEY=

# API ルートを呼び出すためのベース URL（例: http://localhost:3000）
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Analytics の測定 ID（本番環境でのみ挿入される。ローカルでは空でよい）
NEXT_PUBLIC_GA_ID=

# true にすると /api/nearbySearch が実 API の代わりに src/mocks/nearbySearch.json を返す。
# API キーなし・APIコールの消費なしで検索フローを確認したいときに使う。
# 未指定（既定）の場合は開発環境でも実 API を呼び出す。
USE_MOCK_NEARBY_SEARCH=
